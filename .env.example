# ==============================================================================
# VARIABEL LINGKUNGAN PUBLIK (Boleh dan dapat diakses di klien dan server)
# Berikan awalan NEXT_PUBLIC_ untuk variabel di bagian ini.
# ==============================================================================

# URL API proyek Supabase, boleh diakses oleh browser klien dan server
NEXT_PUBLIC_SUPABASE_URL=

# Kunci anon atau publik Supabase untuk kueri berbasis RLS, aman diakses di browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat basis URL situs untuk keperluan navigasi dan tautan email
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Menampilkan lowongan dan data contoh percontohan. Nilai true hanya untuk dev dan demo, kosongkan atau false di produksi
NEXT_PUBLIC_SHOW_DEMO=true

# ==============================================================================
# VARIABEL LINGKUNGAN RAHASIA SERVER (Khusus server, JANGAN diberi awalan NEXT_PUBLIC_)
# Dilarang membocorkan atau memanggil variabel di bawah ini pada komponen klien.
# ==============================================================================

# Kunci service role Supabase dengan bypass RLS, hanya boleh dipakai di lib/supabase/admin.ts (JANGAN diberi awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Kunci API layanan Resend untuk pengiriman email notifikasi di lib/email/ (JANGAN diberi awalan NEXT_PUBLIC_)
RESEND_API_KEY=

# Identitas dan alamat email pengirim notifikasi resmi sistem di lib/email/ (JANGAN diberi awalan NEXT_PUBLIC_)
EMAIL_FROM=
